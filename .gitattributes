# Normalize line endings for all text files
* text=auto eol=lf

# Explicit common text formats
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# Windows scripts can stay CRLF if you add any later
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
