{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "version",
    "date",
    "sensitivity",
    "pii",
    "status",
    "canonical",
    "source_attachment_ids"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d{4}-\\d{2}-\\d{2}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public_internal",
        "internal",
        "restricted"
      ]
    },
    "pii": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "canonical": {
      "type": "boolean"
    },
    "source_attachment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "patternProperties": {
    "^x_": {
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "object",
        "null"
      ]
    }
  }
}