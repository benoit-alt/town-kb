{
  "rules": [
    {
      "glob": "kb/canonical/**/*.md",
      "schema": "scripts/frontmatter-schemas/global_8_field.schema.json"
    },
    {
      "glob": "kb/_templates/**/*.md",
      "schema": "scripts/frontmatter-schemas/global_8_field.schema.json"
    },
    {
      "glob": "architecture/specs/**/*.md",
      "schema": "scripts/frontmatter-schemas/global_8_field.schema.json"
    },
    {
      "glob": "ops/**/*.md",
      "schema": "scripts/frontmatter-schemas/ops_extended.schema.json"
    }
  ],
  "ignore": [
    "**/node_modules/**",
    "**/.git/**",
    "docs/**",
    "manifests/**",
    "**/.keep"
  ]
}